# TaskFlow ML Services Environment Variables
# Copy this file to .env and update with your actual values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB Configuration (for training data)
DYNAMODB_TASKS_TABLE=taskflow-tasks
DYNAMODB_USERS_TABLE=taskflow-users

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model Configuration
MODEL_UPDATE_INTERVAL=3600  # seconds
TRAINING_DATA_LIMIT=10000
RECOMMENDATION_LIMIT=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=ml_service.log

# Performance Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
