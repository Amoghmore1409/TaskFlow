# TaskFlow Frontend Environment Variables
# Copy this file to .env and update with your actual values

# API Configuration
REACT_APP_API_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com/prod
REACT_APP_AWS_REGION=us-east-1

# Cognito Configuration
REACT_APP_USER_POOL_ID=us-east-1_XXXXXXXXX
REACT_APP_USER_POOL_CLIENT_ID=your-client-id

# S3 Configuration
REACT_APP_S3_BUCKET=taskflow-uploads-account-region

# ML API Configuration (optional)
REACT_APP_ML_API_URL=http://your-ec2-instance:8000

# Google Calendar Integration (optional)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id

# Slack Integration (optional)
REACT_APP_SLACK_CLIENT_ID=your-slack-client-id

# Analytics (optional)
REACT_APP_ANALYTICS_APP_ID=your-analytics-app-id
